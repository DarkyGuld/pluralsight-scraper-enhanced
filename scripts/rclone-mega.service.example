[Unit]
Description=MEGA mount for Jellyfin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/rclone mount mega: %h/mega --vfs-cache-mode full --vfs-cache-max-size 20G --vfs-cache-max-age 24h --dir-cache-time 1h --poll-interval 0 --vfs-read-ahead 128M --buffer-size 32M --vfs-read-chunk-size 32M --vfs-read-chunk-size-limit 1G
ExecStop=/bin/sh -c '/usr/bin/fusermount3 -u %h/mega || true'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
